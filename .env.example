# All set in Vercel (Production). Secrets can't be pulled locally; migrations run in `vercel-build`.
DATABASE_URL=            # Neon (own account), pooled connection string
BLOB_READ_WRITE_TOKEN=   # Vercel Blob store "board-images"
GEMINI_API_KEY=
BOARD_PASSWORD=          # long and random: the only door to /edit
BOARD_SECRET=            # openssl rand -hex 32
CRON_SECRET=             # openssl rand -hex 32 (Vercel sends it to the cron routes)
# Optional caps (calls per UTC day)
GEMINI_DAILY_CALLS=500
SEARCH_DAILY_CALLS=300
